<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">
    <route id="import-sales-history">
        <from uri="file://{{integration.sftp.root}}/transactions?delay=10000&amp;{{archive.file}}&amp;{{read.lock}}"/>

        <log message="Processing: ${header.CamelFileName}" loggingLevel="INFO"/>

        <split aggregationStrategy="recordsCountAggregation" streaming="true">
            <tokenize group="10000" token="\n"/>

            <to uri="pfx-csv:unmarshal?skipHeaderRecord=true&amp;delimiter=%09"/>

            <log loggingLevel="INFO" message="Loading batch #${exchangeProperty.CamelSplitIndex + 1} of ${header.CamelFileName} (batch size: 10000, starting at row ${exchangeProperty.CamelSplitIndex * 10000 + 1})"/>

            <to uri="pfx-api:loaddata?objectType=DMDS&amp;dsUniqueName=DMDS.SalesHistoryDS&amp;mapper=import-sales-history.mapper"/>
        </split>

        <log message="Load completed, total records: ${header.PfxTotalInputRecordsCount}" loggingLevel="INFO"/>

        <onCompletion onCompleteOnly="true">
            <toD uri="pfx-api:flush?dataFeedName=DMF.SalesHistoryDS&amp;dataSourceName=DMDS.SalesHistoryDS"/>
            <log message="Flush completed for SalesHistoryDS." loggingLevel="INFO"/>
        </onCompletion>
    </route>
</routes>
