{
  "eval_id": 0,
  "eval_name": "pa-saleshistory-tab",
  "category": "positive",
  "prompt": "Sales transaction file (10M rows per day) needs to land in our PA Data Source SalesHistoryDS. Tab-separated, lots of columns. Comes in at /sftp/transactions/.",
  "assertions": [
    {"id": "uses-objectType-DMDS", "text": "Generated route URI uses objectType=DMDS", "type": "grep", "patterns": ["objectType=DMDS"], "scope": "outputs"},
    {"id": "has-split-streaming", "text": "Route has <split streaming=\"true\"> for handling the 10M-row file", "type": "grep", "patterns": ["<split[^>]*streaming=\"true\"", "streaming=\"true\""], "match": "any", "scope": "outputs"},
    {"id": "has-tokenize", "text": "Route uses <tokenize ... group=N> chunking", "type": "grep", "patterns": ["<tokenize"], "scope": "outputs"},
    {"id": "uses-loaddata-not-loaddatafile", "text": "Uses pfx-api:loaddata (NOT loaddataFile) for DMDS", "type": "grep", "patterns": ["pfx-api:loaddata\\?", "pfx-api:loaddata&"], "match": "any", "scope": "outputs"},
    {"id": "no-loaddatafile", "text": "Does NOT use pfx-api:loaddataFile (forbidden for DMDS)", "type": "grep_absent", "patterns": ["pfx-api:loaddataFile"], "scope": "outputs"},
    {"id": "flush-present", "text": "pfx-api:flush is present after the load", "type": "grep", "patterns": ["pfx-api:flush"], "scope": "outputs"},
    {"id": "tab-delimiter", "text": "CSV unmarshal is configured for tab delimiter", "type": "grep", "patterns": ["delimiter=\\\\t", "delimiter=%09", "\\\\t", "tab"], "match": "any", "scope": "outputs"}
  ]
}
