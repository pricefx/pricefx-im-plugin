<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">
    <route id="import-products">
        <from uri="file://{{integration.sftp.root}}/import/products?delay=10000&amp;include=.*\.csv&amp;{{archive.file}}&amp;{{read.lock}}"/>
        <log message="Starting product import from ${header.CamelFileName}"/>
        <to uri="pfx-csv:streamingUnmarshal?skipHeaderRecord=true&amp;useReusableParser=true"/>
        <to uri="pfx-api:loaddataFile?objectType=P&amp;mapper=import-products.mapper&amp;businessKeys=sku&amp;batchSize=100000"/>
        <log message="Loaded products from ${header.CamelFileNameOnly}; total records: ${header.PfxTotalInputRecordsCount}"/>
        <onCompletion onCompleteOnly="true">
            <log message="Triggering internal copy for Product"/>
            <to uri="pfx-api:internalCopy?label=Product"/>
        </onCompletion>
    </route>
</routes>
