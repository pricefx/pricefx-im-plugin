<routes xmlns="http://camel.apache.org/schema/spring">
    <route id="import-ppv-company-params">
        <from uri="file://{{integration.sftp.root}}/inbound/company-params?delay=10000&amp;{{archive.file}}&amp;{{read.lock}}"/>

        <log message="Processing: ${header.CamelFileName}" loggingLevel="INFO"/>

        <to uri="pfx-csv:streamingUnmarshal?skipHeaderRecord=true&amp;useReusableParser=true&amp;delimiter=,"/>

        <to uri="pfx-api:loaddataFile?objectType=LTV&amp;pricingParameterName=CompanyParams&amp;mapper=import-ppv-company-params.mapper&amp;batchSize=500000"/>

        <log message="Import completed for file: ${header.CamelFileName}" loggingLevel="INFO"/>
    </route>
</routes>
