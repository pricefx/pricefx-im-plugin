<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">
    <route id="import-ppv-exchange-rates">
        <from uri="file://{{integration.sftp.root}}/exchange-rates?delay=10000&amp;scheduler=quartz&amp;scheduler.cron=0+0+6+*+*+?&amp;{{archive.file}}&amp;{{read.lock}}"/>

        <log message="Processing ECB exchange rates file: ${header.CamelFileName}" loggingLevel="INFO"/>

        <to uri="pfx-csv:streamingUnmarshal?skipHeaderRecord=true&amp;useReusableParser=true&amp;delimiter=,"/>

        <to uri="pfx-api:loaddataFile?objectType=LTV&amp;pricingParameterName=ExchangeRates&amp;mapper=import-ppv-exchange-rates.mapper&amp;batchSize=500000"/>

        <log message="Import completed for file: ${header.CamelFileName}" loggingLevel="INFO"/>
    </route>
</routes>
