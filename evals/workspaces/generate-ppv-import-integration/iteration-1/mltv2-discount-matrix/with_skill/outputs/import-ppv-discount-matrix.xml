<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">
    <route id="import-ppv-discount-matrix">
        <from uri="file://{{integration.sftp.root}}/import/discount-matrix?delay=10000&amp;{{archive.file}}&amp;{{read.lock}}"/>

        <log message="Processing: ${header.CamelFileName}" loggingLevel="INFO"/>

        <to uri="pfx-csv:streamingUnmarshal?skipHeaderRecord=true&amp;useReusableParser=true&amp;delimiter=,"/>

        <to uri="pfx-api:loaddataFile?objectType=MLTV2&amp;pricingParameterName=DiscountMatrix&amp;mapper=import-ppv-discount-matrix.mapper&amp;batchSize=100000"/>

        <log message="Import completed for file: ${header.CamelFileName}" loggingLevel="INFO"/>
    </route>
</routes>
