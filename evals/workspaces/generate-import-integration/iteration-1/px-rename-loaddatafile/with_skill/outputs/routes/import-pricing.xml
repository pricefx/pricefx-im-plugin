<routes xmlns="http://camel.apache.org/schema/spring">
    <route id="import-pricing">
        <from uri="file://{{integration.sftp.root}}/pricing?delay=10000&amp;{{archive.file}}&amp;{{read.lock}}&amp;{{error.file}}"/>

        <log message="Processing: ${header.CamelFileName}" loggingLevel="INFO"/>

        <!-- Streaming CSV parse -->
        <to uri="pfx-csv:streamingUnmarshal?skipHeaderRecord=true&amp;useReusableParser=true&amp;delimiter=,"/>

        <!-- Import to Pricefx via file upload (PX, 3 fields => high batch size acceptable) -->
        <to uri="pfx-api:loaddataFile?objectType=PX&amp;mapper=import-pricing.mapper&amp;batchSize=500000"/>

        <log message="Import completed for file: ${header.CamelFileName}. Records: ${header.PfxTotalInputRecordsCount}" loggingLevel="INFO"/>
    </route>
</routes>
