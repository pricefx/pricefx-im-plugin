{
  "eval_id": 2,
  "eval_name": "c-customer-sftp-6am",
  "category": "positive",
  "prompt": "Customer master file lands at SFTP /upload/customer-master.csv every morning at 6am. Push it into Pricefx C objectType, business key is customerId.",
  "assertions": [
    {"id": "uses-objectType-C", "text": "Generated route uses objectType=C (not CX)", "type": "grep", "patterns": ["objectType=C(?![A-Z])"]},
    {"id": "businesskeys-customerId", "text": "Business key is customerId", "type": "grep", "patterns": ["businessKeys=customerId"]},
    {"id": "6am-cron", "text": "Cron fires at 6 AM (cron field for hour=6)", "type": "grep", "patterns": ["\\+6\\+", "\\+06\\+", " 6 ", " 06 "], "match": "any"},
    {"id": "sftp-source", "text": "Route reads from pfx-sftp or file with sftp path", "type": "grep", "patterns": ["pfx-sftp:", "file:", "customer-master"], "match": "any"},
    {"id": "no-pa-ltv-pattern", "text": "No PA / DMDS / LTV / MLTV2 patterns in route/mapper", "type": "grep_absent", "patterns": ["DMDS", "objectType=LTV", "objectType=MLTV2", "pfx-api:flush", "pricingParameterName="], "scope": "outputs"}
  ]
}
