<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">
    <route id="import-products">
        <from uri="file://{{integration.sftp.root}}/import?delay=10000&amp;scheduler=quartz&amp;scheduler.cron=0+0+6+*+*+?&amp;include=products\.csv&amp;{{archive.file}}&amp;{{read.lock}}&amp;{{error.file}}"/>

        <log message="Processing: ${header.CamelFileName}" loggingLevel="INFO"/>

        <!-- Streaming CSV parse -->
        <to uri="pfx-csv:streamingUnmarshal?skipHeaderRecord=true&amp;useReusableParser=true&amp;delimiter=,"/>

        <!-- Import to Pricefx via file upload -->
        <to uri="pfx-api:loaddataFile?objectType=P&amp;mapper=import-products.mapper&amp;batchSize=500000"/>

        <log message="Import completed for file: ${header.CamelFileName}. Records: ${header.PfxTotalInputRecordsCount}" loggingLevel="INFO"/>
    </route>
</routes>
